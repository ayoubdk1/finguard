{
  "uid": "finguard-p3-overview",
  "title": "FinGuard Reliability & Fraud Observability",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Request Latency (p95)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(finguard_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "heatmap",
      "title": "Fraud Risk Score Distribution",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(finguard_fraud_risk_score_bucket[5m])) by (le)",
          "legendFormat": "score <= {{le}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transfers Processed by Currency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(finguard_transfers_total[5m])) by (currency, status)",
          "legendFormat": "{{currency}} ({{status}})"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rate Limit 429 Hits",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(finguard_rate_limit_hits_total[5m])) by (limiter)",
          "legendFormat": "{{limiter}}"
        }
      ]
    }
  ]
}