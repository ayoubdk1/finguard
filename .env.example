# FinGuard Environment Variables
FINGUARD_ENV=production
FINGUARD_STRICT_AUTH=1
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://finguard:CHANGE_ME@db:5432/finguard
FINGUARD_JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
FINGUARD_MFA_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
FINGUARD_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
FINGUARD_CORS_ORIGINS=https://app.finguard.example
FINGUARD_OUTBOX_MAX_ATTEMPTS=5
FINGUARD_OUTBOX_POLL_SECONDS=2.0
FINGUARD_EXPOSE_RESET_TOKEN=0
FINGUARD_DEMO_MODE=0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
